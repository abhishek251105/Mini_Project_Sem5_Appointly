generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REQUIRES_REFUND
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum NotificationType {
  BOOKING_CONFIRMED_HOST
  BOOKING_CONFIRMED_GUEST
  BOOKING_CANCELLED_GUEST
  BOOKING_RESCHEDULED_GUEST
  BOOKING_CANCELLED_HOST
  BOOKING_RESCHEDULED_HOST
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  slug      String   @unique
  timeZone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetingTypes          MeetingType[]
  availabilityRules     AvailabilityRule[]
  availabilityOverrides AvailabilityOverride[]
  bookings              Booking[]
}

model MeetingType {
  id           String   @id @default(cuid())
  title        String
  description  String?
  duration     Int
  location     String?
  priceInPaise Int      @default(0)
  currency     String   @default("INR")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hostId   String
  host     User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model AvailabilityRule {
  id        String @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  hostId    String
  host      User   @relation(fields: [hostId], references: [id], onDelete: Cascade)
}

model AvailabilityOverride {
  id        String   @id @default(cuid())
  date      DateTime
  startTime String?
  endTime   String?
  isBlocked Boolean  @default(true)
  reason    String?
  hostId    String
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
}

model Booking {
  id            String                @id @default(cuid())
  guestName     String
  guestEmail    String
  startTime     DateTime
  endTime       DateTime
  status        BookingStatus         @default(CONFIRMED)
  notes         String?
  createdAt     DateTime              @default(now())
  expiresAt     DateTime?
  hostId        String
  meetingTypeId String
  meetingType   MeetingType           @relation(fields: [meetingTypeId], references: [id], onDelete: Restrict)
  host          User                  @relation(fields: [hostId], references: [id], onDelete: Restrict)
  payments      Payment[]
  notifications BookingNotification[]
}

model Payment {
  id        String        @id @default(cuid())
  bookingId String
  amount    Int
  currency  String        @default("INR")
  status    PaymentStatus @default(PENDING)

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  refundReason         String?
  razorpayRefundId     String?   @unique
  refundedAt           DateTime?
  refundIdempotencyKey String?   @unique
  refundRequestedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
}

model BookingNotification {
  id        String             @id @default(cuid())
  bookingId String
  type      NotificationType
  status    NotificationStatus @default(PENDING)
  attempts  Int                @default(0)
  emailId   String?
  lastError String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  sentAt    DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([bookingId, type])
  @@index([status])
}
